/* 自定义 tabBar：毛玻璃悬浮底栏
   组件样式默认与页面隔离，所以这里要写完整，不能依赖 app.wxss */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  height: 100rpx;
  /* iPhone 底部横条安全区，两行是为了兼容新旧 iOS */
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 253, 249, 0.68);
  backdrop-filter: blur(26px);
  -webkit-backdrop-filter: blur(26px);
  border-top: 1rpx solid rgba(230, 226, 217, 0.7);
  box-shadow: 0 -6rpx 24rpx rgba(70, 96, 95, 0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-text {
  font-size: 20rpx;
  line-height: 1.4;
  margin-top: 2rpx;
}
