<!-- 首页：顶部五张轮播图 + 特色推荐 -->
<swiper
  class="banner-swiper"
  indicator-dots="{{true}}"
  indicator-color="rgba(255,255,255,0.45)"
  indicator-active-color="#ffffff"
  autoplay="{{true}}"
  circular="{{true}}"
  interval="4000"
  duration="500"
>
  <swiper-item wx:for="{{banners}}" wx:key="id">
    <view class="banner-item" data-id="{{item.spotId}}" bindtap="onBannerTap">
      <image
        wx:if="{{item.image}}"
        class="banner-img"
        src="{{item.image}}"
        mode="aspectFill"
        binderror="onBannerImgError"
        data-idx="{{index}}"
      ></image>
      <view wx:else class="banner-img banner-ph" style="background: {{item.bg}};">
        <view class="ph-blob ph-blob-1"></view>
        <view class="ph-blob ph-blob-2"></view>
      </view>
      <view class="banner-mask">
        <view class="banner-tag">
          <view class="banner-title">{{item.title}}</view>
          <view class="banner-sub">{{item.subtitle}}</view>
        </view>
      </view>
    </view>
  </swiper-item>
</swiper>

<view class="wrap wrap-tabbar">

  <view class="section-title">特色推荐</view>

  <view
    class="card"
    wx:for="{{hot}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="goDetail"
  >
    <view class="thumb">
      <image
        wx:if="{{item.image}}"
        src="{{item.image}}"
        mode="aspectFill"
        binderror="onThumbImgError"
        data-idx="{{index}}"
      ></image>
      <block wx:else>{{item.first}}</block>
    </view>
    <view class="card-body">
      <view>
        <view class="card-title">
          {{item.name}}
          <text class="star" wx:if="{{item.fav}}">★</text>
        </view>
        <view class="card-summary">{{item.summary}}</view>
      </view>
      <view class="tags">
        <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
      </view>
    </view>
  </view>

  <view class="btn ghost" bindtap="goList">查看全部景点</view>

</view>
