<view class="wrap wrap-tabbar">

  <view class="search-sticky">
    <view class="search">
      <input
        value="{{keyword}}"
        placeholder="搜索景点名称、标签或介绍"
        confirm-type="search"
        bindinput="onInput"
        bindconfirm="onSearch"
      />
      <view class="search-btn" bindtap="onClear" wx:if="{{keyword}}">清空</view>
      <view class="search-btn" bindtap="onSearch" wx:else>搜索</view>
    </view>

    <scroll-view class="cats" scroll-x="true">
      <view
        class="cat {{category === item ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        data-cat="{{item}}"
        bindtap="onCat"
      >{{item}}</view>
    </scroll-view>
  </view>

  <view
    class="card"
    wx:for="{{list}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="goDetail"
  >
    <view class="thumb">
      <image
        wx:if="{{item.image}}"
        src="{{item.image}}"
        mode="aspectFill"
        binderror="onThumbImgError"
        data-idx="{{index}}"
      ></image>
      <block wx:else>{{item.first}}</block>
    </view>
    <view class="card-body">
      <view>
        <view class="card-title">
          {{item.name}}
          <text class="star" wx:if="{{item.fav}}">★</text>
        </view>
        <view class="card-summary">{{item.summary}}</view>
      </view>
      <view class="tags">
        <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{list.length === 0}}">
    <view>没有找到相关景点</view>
    <view>换个关键词试试</view>
  </view>

</view>
